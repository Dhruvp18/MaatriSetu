# production
build/
dist/

# environment — never commit real credentials
.env
.env.local
.env*.local
# Backups and editor scratch copies of env files. `.env*.local` does not match a
# trailing suffix, so `.env.local.bak` would otherwise be committed with live
# credentials in it.
.env*.bak
.env.*.backup
*.env.local

