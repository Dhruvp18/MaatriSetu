# ---------------------------------------------------------------------------
# MaatriSetu environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# `pnpm db:start` prints the local anon/service keys on first run.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Local defaults shown; replace with hosted project values when deploying.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses RLS. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres connection, used by the worker's job queue (pg-boss).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Application ----------------------------------------------------------
# Absolute origin, used to build the referral QR link.
APP_BASE_URL="http://localhost:3000"

# Referral links carry a random opaque token; only its SHA-256 hash is stored,
# so there is no signing secret to configure. Lifetime is, in hours.
REFERRAL_TOKEN_TTL_HOURS="24"

# Signs the patient portal's session cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PATIENT_SESSION_SECRET=""

# Bearer secret for POST /api/queue/drain, which pg_cron calls every minute
# (migration 0028). Store the same value in Supabase Vault as
# `queue_drain_secret`. Locally, `pnpm worker:dev` drains the queues instead.
QUEUE_DRAIN_SECRET=""

# Demo only: a visitor with no patient session sees the seeded patient
# (Sunita Devi). Never "true" where real patient data exists.
PATIENT_DEMO_SESSION="false"

# --- Extraction (OCR) -----------------------------------------------------
# Provider is pluggable; see src/modules/reports. Leave blank to use the
# built-in fixture provider, which is visibly labelled as synthetic in the UI.
OCR_PROVIDER="fixture"          # fixture | gemini | google  (gemini uses GEMINI_API_KEY)
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Speech (Sarvam AI Saaras) --------------------------------------------
SPEECH_PROVIDER="fixture"       # fixture | sarvam
SARVAM_API_KEY=""

# --- Patient Chatbot (Gemini) -------------------------------------------
# Used for triage classification in the patient mobile interface.
GEMINI_API_KEY=""
# Shared by OCR, speech and chat. 2.x models are closed to new keys.
GEMINI_MODEL="gemini-3.1-flash-lite"

# --- Clinic contact (Patient Interface CTAs) ----------------------------
# Shown on CRITICAL / IMPORTANT chatbot responses as a tel: link.
CLINIC_PHONE_NUMBER="+911234567890"

# --- Messaging (WhatsApp Business Cloud API) ------------------------------
# Disabled by default. Clinical auto-replies stay OFF until wording,
# escalation ownership and delivery handling are approved.
MESSAGING_PROVIDER="disabled"   # disabled | whatsapp
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
