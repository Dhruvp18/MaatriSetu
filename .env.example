# ---------------------------------------------------------------------------
# MaatriSetu environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# `pnpm db:start` prints the local anon/service keys on first run.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Local defaults shown; replace with hosted project values when deploying.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses RLS. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres connection, used by the worker's job queue (pg-boss).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Application ----------------------------------------------------------
# Absolute origin, used to build the referral QR link.
APP_BASE_URL="http://localhost:3000"

# Signing secret for referral access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REFERRAL_TOKEN_SECRET=""

# Lifetime of a referral share token, in hours.
REFERRAL_TOKEN_TTL_HOURS="24"

# --- Extraction (OCR) -----------------------------------------------------
# Provider is pluggable; see src/modules/reports. Leave blank to use the
# built-in fixture provider, which is visibly labelled as synthetic in the UI.
OCR_PROVIDER="fixture"          # fixture | anthropic | google
ANTHROPIC_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Speech (Sarvam AI Saaras) --------------------------------------------
SPEECH_PROVIDER="fixture"       # fixture | sarvam
SARVAM_API_KEY=""

# --- Messaging (WhatsApp Business Cloud API) ------------------------------
# Disabled by default. Clinical auto-replies stay OFF until wording,
# escalation ownership and delivery handling are approved.
MESSAGING_PROVIDER="disabled"   # disabled | whatsapp
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
