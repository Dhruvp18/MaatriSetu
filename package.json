{
  "name": "maatrisetu",
  "version": "0.1.0",
  "private": true,
  "description": "Assistive paper-to-digital antenatal consultation cockpit for high-volume Indian OPDs.",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > src/core/db/database.types.ts",
    "verify:schema": "bash scripts/verify-schema.sh",
    "worker:dev": "tsx watch --env-file=.env.local --conditions=react-server worker/src/index.ts",
    "worker:start": "tsx --env-file=.env.local --conditions=react-server worker/src/index.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^18.0.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pg-boss": "^10.3.2",
    "supabase": "^2.48.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
